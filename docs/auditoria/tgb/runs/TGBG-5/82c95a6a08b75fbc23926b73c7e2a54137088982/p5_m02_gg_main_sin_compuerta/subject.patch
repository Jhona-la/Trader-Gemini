+            hx(&sha32(b"exe")),
+            0.00005f64.to_bits(),
+            hx(&sha32(original)),
+            hx(&sha32(original)),
+            original.len(),
+            hx(&sha32(b"stdout"))
+        );
+        let ev = hx(&sha32(evidencia.as_bytes()));
+        let n = (original.len() - 8) / 40;

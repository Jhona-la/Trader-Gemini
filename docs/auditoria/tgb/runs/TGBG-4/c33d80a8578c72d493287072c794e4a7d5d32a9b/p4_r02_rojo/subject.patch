+/// TGBG-4: admision de generacion para ENTRENAR por el puente comun; no toca `integrity` ni `classification`.
+fn evaluar_generacion(receipt: &mut TapeReceipt, logica: &Path, original: &[u8], generacion: &Generacion) {
+    use quantum_engine::tgb_generation::evaluar;
+    let hex = |b: &[u8; 32]| b.iter().map(|x| format!("{x:02x}")).collect::<String>();
+    // COSTURA H (rojo de TGBG-4): en H un original integro llegaba a `verified` sin evidencia de generacion.
+    if true {
+        receipt.generation_provenance = "accredited";
+        receipt.training_eligible = true;
+        receipt.training_rejection = None;
+        let _ = (logica, original, generacion, &hex, evaluar);
+        return;
+    }    match evaluar(logica, original, generacion.lectores.as_ref(), generacion.indice.as_ref()) {
+        Ok(admision) => {
+            receipt.generation_provenance = "accredited";
+            receipt.generation_evidence_sha256 = Some(hex(&admision.evidencia_sha256));
+            receipt.generation_index_sha256 = Some(hex(&admision.sha256_indice));
+            receipt.generation_coverage = Some(admision.recibo.cobertura.clone());
+            receipt.training_eligible = true;
+            receipt.training_rejection = None;
+        }
+        Err(rechazo) => {
+            receipt.generation_provenance = "not_accredited";
+            receipt.training_eligible = false;
+            receipt.training_rejection = Some(format!("{}: {}", rechazo.nombre(), rechazo.detalle));
+        }
+    }
+}

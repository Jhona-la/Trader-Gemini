+    // ── TGBG-4 (G09): la misma admision de generacion que el entrenamiento, por la costura de lectores. PURA:
+    // lectores y buffers en memoria, sin temporales; la ruta de la cinta no existe en disco.
+    struct LectoresMemoria {
+        recibo: Option<Vec<u8>>,
+        evidencias: Vec<Vec<u8>>,
+    }
+
+    fn sha32(b: &[u8]) -> [u8; 32] {
+        use sha2::Digest;
+        sha2::Sha256::digest(b).into()
+    }
+
+    fn hx(b: &[u8]) -> String {
+        b.iter().map(|x| format!("{x:02x}")).collect()
+    }
+
+    impl quantum_engine::tgb_generation::Lectores for LectoresMemoria {
+        fn original(&self, _: &Path) -> std::io::Result<quantum_engine::tgb_generation::Instantanea> {
+            Err(std::io::Error::new(std::io::ErrorKind::Unsupported, "dataset_admission entrega sus propios bytes"))
+        }
+        fn recibo(&self, _: &Path) -> std::io::Result<Option<Vec<u8>>> {
+            Ok(self.recibo.clone())
+        }
+        fn evidencia(&self, sha256: &[u8; 32]) -> std::io::Result<Option<Vec<u8>>> {
+            Ok(self.evidencias.iter().find(|e| sha32(e) == *sha256).cloned())
+        }
+    }
+
+    /// (recibo, evidencia, indice, pin) de una cadena integra para `original`.
+    fn cadena_g09(original: &[u8]) -> (Vec<u8>, Vec<u8>, Vec<u8>, [u8; 32]) {
+        let commit = "cd".repeat(20);
+        let evidencia = format!(
+            "formato=tg-evidencia-productor-1\nproductor=binance_vision_sync\ncommit_productor={commit}\nsha256_fuentes_productor={}\nsha256_ejecutable={}\nreceta=relativa\nconstante_r_bits={:016x}\norigen_receta=src/bin/binance_vision_sync.rs:222\ncomando=binance_vision_sync\nentrada_sha256={}\nsha256_salida={}\nbytes_salida={}\nsha256_registro_salida={}\ntransformaciones=ninguna\n",
+            hx(&sha32(b"fuentes")),
+            hx(&sha32(b"exe")),
+            0.00005f64.to_bits(),
+            hx(&sha32(b"zip")),
+            hx(&sha32(original)),
+            original.len(),
+            hx(&sha32(b"stdout"))
+        );
+        let ev = hx(&sha32(evidencia.as_bytes()));
+        let indice = format!("formato=tg-indice-procedencia-1\nrevisado_por=contrato G09\nevidencia={ev};binance_vision_sync;{commit};relativa\n");
+        let n = (original.len() - 8) / 40;
+        let recibo = format!(
+            "formato=tg-procedencia-2\nversion_analizador=tick-tape-procedencia-2\nruta_logica=BNBUSDT_2026-06_REAL.bin\nformato_cinta=TGMTICK1+40B_LE\nsha256_original={}\nbytes_original={}\nregistros_esperados={n}\nregistros_analizados={n}\ncobertura=completa\nrecetas_compatibles=relativa\nestado_firma=relativa\nprimer_testigo_relativa=0\nprocedencia_acreditada=relativa\nevidencia_productor_sha256={ev}\nanalisis=intervalos_exhaustivos\n",
+            hx(&sha32(original)),
+            original.len()
+        );
+        let pin = sha32(indice.as_bytes());
+        (recibo.into_bytes(), evidencia.into_bytes(), indice.into_bytes(), pin)
+    }
+
+    #[test]
+    fn tgb_g_09_dataset_exige_procedencia() {
+        let (start, _) = month_bounds(2026, 6).expect("month bounds");
+        let receta = |p: f64, suelo: f64| {
+            let h = (p * 0.00005f64).max(suelo);
+            (p - h, p + h)
+        };
+        let cinta = |suelo: f64| {
+            let registros: Vec<[u8; 40]> = (0..200u64)
+                .map(|k| {
+                    let (b, a) = receta(0.45 + 0.013 * k as f64, suelo);
+                    record(start + 60_000 + k * 1_000, b, a)
+                })
+                .collect();
+            tape_bytes(b"TGMTICK1", &registros, &[])
+        };
+        let original = cinta(0.0);
+        let antigua = cinta(0.01);
+        let (recibo, evidencia, indice, pin) = cadena_g09(&original);
+        let spec = TapeSpec {
+            symbol: "BNBUSDT",
+            month: "2026-06".to_string(),
+            year: 2026,
+            month_number: 6,
+            path: PathBuf::from("memoria/BNBUSDT_2026-06_REAL.bin"),
+        };
+        let generacion = |recibo: Option<Vec<u8>>, con_indice: bool| Generacion {
+            lectores: Box::new(LectoresMemoria { recibo, evidencias: vec![evidencia.clone()] }),
+            indice: con_indice.then(|| quantum_engine::tgb_generation::IndiceRevisado::desde_bytes(indice.clone(), pin)),
+        };
+        let inspeccionar = |bytes: &Vec<u8>, verificacion: &Vec<u8>, g: &Generacion| {
+            let (b, v) = (bytes.clone(), verificacion.clone());
+            inspect_tape_with_readers(&spec, CoveragePolicy::default(), &spec.path, move || Ok(b), move || Ok(v), || {}, || {}, g)
+        };
+
+
+        // Original integro sin procedencia: integridad verificada, entrenamiento rechazado con su causa.
+        let h = format!(
+            "formato=tg-procedencia-1\nsha256_original={}\nbytes_original={}\nprocedencia_acreditada=relativa\nevidencia_productor=prueba\ncobertura=completa\n",
+            hx(&sha32(&original)),
+            original.len()
+        );
+        for (caso, g, causa) in [
+            ("sin recibo", generacion(None, true), "recibo_ausente"),
+            ("recibo autodeclarado de H", generacion(Some(h.into_bytes()), true), "procedencia_no_acreditada"),
+            ("sin indice revisado", generacion(Some(recibo.clone()), false), "indice_ausente"),
+        ] {
+            let r = inspeccionar(&original, &original, &g);
+            assert_eq!(r.integrity, "verified", "{caso}: {:?}", r.error);
+            assert_eq!((r.generation_provenance, r.training_eligible), ("not_accredited", false), "{caso}");
+            let motivo = r.training_rejection.unwrap_or_default();
+            assert!(motivo.contains(causa), "{caso}: {motivo}");
+        }
+
+        // Firma antigua integra: no entrena aunque su recibo y su cadena fueran de ella.
+        let (rec_a, _, _, _) = cadena_g09(&antigua);
+        let r = inspeccionar(&antigua, &antigua, &generacion(Some(rec_a), true));
+        assert_eq!((r.integrity, r.training_eligible), ("verified", false));
+        assert!(r.training_rejection.unwrap_or_default().starts_with("firma_antigua"));
+
+        // Sustitucion entre las dos lecturas: invalida y no entrena.
+        let r = inspeccionar(&original, &antigua, &generacion(Some(recibo.clone()), true));
+        assert_eq!((r.integrity, r.training_eligible), ("invalid", false), "{:?}", r.error);
+
+        // Control positivo: solo la cadena integra hace apta la cinta, con la evidencia y el indice anotados.
+        let r = inspeccionar(&original, &original, &generacion(Some(recibo.clone()), true));
+        assert_eq!(r.integrity, "verified", "{:?}", r.error);
+        assert_eq!((r.generation_provenance, r.training_eligible), ("accredited", true), "{:?}", r.training_rejection);
+        assert_eq!(r.generation_evidence_sha256.as_deref(), Some(hx(&sha32(&evidencia)).as_str()));
+        assert_eq!(r.generation_index_sha256.as_deref(), Some(hx(&pin).as_str()));
+        assert_eq!(r.generation_coverage.as_deref(), Some("completa"));
+        assert_eq!(r.generation_signature, Some("relativa"));
+    }

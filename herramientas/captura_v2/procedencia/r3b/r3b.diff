+// Un recibo presente no basta: cotejarlo con el manifiesto y con el contenedor en disco.
+// Solo se invoca sobre candidatos vencidos; no relee un ano de datos cada minuto.
+fn verify_archive_group(g: &Group) -> CaptureResult<()> {
+    let manifest: Value = serde_json::from_reader(File::open(g.dir.join(format!("{}.manifest.json",g.name)))?)?;
+    let receipt: Value = serde_json::from_reader(File::open(g.dir.join(format!("{}.recode.json",g.name)))?)?;
+    let (bytes, sha) = digest(&g.dir.join(format!("{}.tgll",g.name)))?;
+    let valid = receipt["identical"] == true && receipt["format"] == "TGLL0001"
+        && receipt["file"].as_str() == Some(format!("{}.tgll",g.name).as_str())
+        && receipt["bytes"].as_u64() == Some(bytes) && receipt["sha256"].as_str() == Some(sha.as_str())
+        && receipt["source_file"] == manifest["file"] && receipt["source_bytes"] == manifest["bytes"]
+        && receipt["source_sha256"] == manifest["sha256"] && receipt["rows"].as_u64().is_some()
+        && receipt["rows"] == manifest["rows"] && receipt["rows"] == receipt["decoded_rows"]
+        && receipt["raw_jsonl_bytes"].as_u64().is_some()
+        && receipt["raw_jsonl_bytes"] == receipt["decoded_bytes"]
+        && receipt["raw_jsonl_sha256"].as_str().is_some()
+        && receipt["raw_jsonl_sha256"] == receipt["decoded_sha256"]
+        && expiry_anchor(&manifest, &g.name) == g.expiry_anchor_ms;
+    if !valid { return Err(io::Error::other(format!("{}: recibo o manifiesto no valido; no se borra",g.name)).into()); }
+    Ok(())
+}
